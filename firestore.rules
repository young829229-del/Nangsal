rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Cart Rules
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Order Security Rules
    match /orders/{orderId} {
      // Allow reading if caller is authenticated owner of the order or matches userEmail
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.userEmail == request.auth.email
      );

      // Create rule: Authenticated users can create orders linked to their UID. Unauthenticated guest orders must be validly structured.
      allow create: if (
        !isAuthenticated() || 
        request.resource.data.userId == request.auth.uid
      ) && request.resource.data.totalAmount >= 0;

      // Update rule: Only allow order status cancellation if order is currently pending/processing
      allow update: if (
        isAuthenticated() && 
        (resource.data.userId == request.auth.uid || resource.data.userEmail == request.auth.email) &&
        request.resource.data.status == "CANCELLED" &&
        (resource.data.status == "PENDING" || resource.data.status == "PROCESSING" || resource.data.status == "CONFIRMED") &&
        // Ensure core financial and product fields cannot be tampered with
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.items == resource.data.items
      );

      // Orders are an immutable audit log - deletion is forbidden
      allow delete: if false;
    }
  }
}
