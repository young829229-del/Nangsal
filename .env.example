# Server Configuration
PORT=3000
NODE_ENV=development

# Server Admin & Authentication Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
ADMIN_BEARER_TOKEN=your_admin_bearer_token

# Client-Side Admin Credentials (VITE_ prefixed)
VITE_ADMIN_PASSWORD=your_admin_password
VITE_ADMIN_BEARER_TOKEN=your_admin_bearer_token

# Firebase Web SDK Configuration (Public Client Safe Credentials)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.region.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key

# Hosting Application Base URL
APP_URL=https://your-app-url.run.app
